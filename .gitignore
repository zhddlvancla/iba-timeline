# 사이트에 필요한 파일만 올린다 (교과서 원본·작업 도구·백업 제외)
/*
!/.gitignore
!/.nojekyll
!/index.html
!/tablet.css
!/globe.css
!/globe.js
!/iba-globe-records.js
!/timeline-content.js
!/audio-engine.js
!/iba-emblem.js
